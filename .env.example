# RUAS Environment Variables
# Lihat techstack.md Bagian 2.5 untuk spesifikasi lengkap

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (SANGAT RAHASIA - Hanya digunakan di Server / Route Handler)
# Dilarang menggunakan prefix NEXT_PUBLIC_ atau diakses dari Client Component
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Detection Engine Configuration ('mock' | 'remote')
# Development lokal: 'mock'
# Production Vercel: 'remote'
AI_PROVIDER=mock

# Remote AI Endpoint (Hosted di Render Web Service)
# Contoh: https://ruas-ai.onrender.com (tanpa trailing path /deteksi)
AI_REMOTE_ENDPOINT=

# Site URL untuk callback auth / invite redirect
# Local Development: http://localhost:3000
# Production Deployment: https://DOMAIN-RUAS-KITA (misal https://ruas.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Akses Cepat Login Demo (Dev-Only Shortcuts)
# WAJIB bernilai false di Production dan Vercel Preview
NEXT_PUBLIC_ENABLE_DEV_SHORTCUTS=false

# Admin Dinas Signup Bypass (Dev / Demo / Lomba)
# Set true untuk mode lomba/demo (tanpa database ASN resmi)
# Set false di production untuk mewajibkan verifikasi NIP terhadap instansi_referensi resmi
ENABLE_DEV_ADMIN_SIGNUP=false
NEXT_PUBLIC_ENABLE_DEV_ADMIN_SIGNUP=false
